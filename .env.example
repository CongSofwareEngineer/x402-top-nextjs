# Coinbase CDP API key pair — create at https://portal.cdp.coinbase.com
# Authenticates against the Coinbase CDP facilitator, which verifies and settles every
# payment. REQUIRED: without these the facilitator rejects calls and paid routes
# fail.
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Your Base payout address (0x..., 42 chars) — where the 0.01 USDC is sent.
# Funds settle straight to this address: CDP never custodies them, which is why
# no CDP_WALLET_SECRET is needed here.
EVM_ADDRESS=0xYourBaseAddressHere

#mainnet
FACILITATOR_URL=https://


NEXT_PUBLIC_SITE_URL=https://



ARGON2_MEMORY_COST= 
ARGON2_TIME_COST= 

# Encrypted private key (Argon2 AES-256-GCM) used by the server-side Web3
# signer (services/web3.ts). Generate with encryptData() in utils/argon2.ts.
PRIVATE_KEY_ENCODE=your-argon2-aes-gcm-encrypted-private-key

# Password used to decrypt PRIVATE_KEY_ENCODE
PRIVATE_KEY_SECRET=your-argon2-password

# Optional. Locks the cron-job route down (calls real USDC). Set on Vercel so
# cron sends `Authorization: Bearer <CRON_SECRET>` automatically.
CRON_SECRET=your-cron-secret

DOMAIN_API=your